+// Accepts "server:port:secret", "tg://proxy?server=...&port=...&secret=..." or "https://t.me/proxy?..."
+static td::Status parse_mtproto_proxy(td::Slice value, ClientParameters *parameters) {
+  td::string server;
+  td::string port;
+  td::string secret;
+  auto query_pos = value.find('?');
+  if (query_pos != td::Slice::npos && (td::begins_with(value, "tg:") || td::begins_with(value, "http"))) {
+    for (auto arg : td::full_split(value.substr(query_pos + 1), '&')) {
+      auto key_value = td::split(arg, '=');
+      auto decoded = td::url_decode(key_value.second, false);
+      if (key_value.first == "server") {
+        server = std::move(decoded);
+      } else if (key_value.first == "port") {
+        port = std::move(decoded);
+      } else if (key_value.first == "secret") {
+        secret = std::move(decoded);
+      }
+    }
+  } else {
+    auto secret_pos = value.rfind(':');
+    if (secret_pos == td::Slice::npos) {
+      return td::Status::Error("MTProto proxy must be in the format server:port:secret");
+    }
+    secret = value.substr(secret_pos + 1).str();
+    auto host_port = value.substr(0, secret_pos);
+    auto port_pos = host_port.rfind(':');
+    if (port_pos == td::Slice::npos) {
+      return td::Status::Error("MTProto proxy must be in the format server:port:secret");
+    }
+    server = host_port.substr(0, port_pos).str();
+    port = host_port.substr(port_pos + 1).str();
+  }
+  if (server.size() > 2 && server[0] == '[' && server.back() == ']') {
+    server = server.substr(1, server.size() - 2);
+  }
+  if (server.empty() || secret.empty()) {
+    return td::Status::Error("MTProto proxy server and secret must be non-empty");
+  }
+  TRY_RESULT(port_number, td::to_integer_safe<td::int32>(port));
+  if (port_number <= 0 || port_number > 65535) {
+    return td::Status::Error("Wrong MTProto proxy port");
+  }
+  parameters->mtproto_proxy_server_ = std::move(server);
+  parameters->mtproto_proxy_port_ = port_number;
+  parameters->mtproto_proxy_secret_ = std::move(secret);
+  return td::Status::OK();
+}
